ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE
# 使用第三方代理时设置，否则留空（默认连接官方 API）
ANTHROPIC_BASE_URL=

# GitHub Personal Access Token（推荐配置）
# 未配置时：匿名 API 限速 60 次/小时；配置后：5000 次/小时
# 获取方式：GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# 所需权限：repo（private 仓库）或 public_repo（仅 public 仓库）
GITHUB_TOKEN=github_pat_YOUR_TOKEN_HERE

# 公网写接口鉴权密钥。配置后，POST/PATCH/DELETE /api/* 需要请求头 X-CUE-API-Key。
CUE_API_KEY=

# 企业微信群机器人 Webhook URL（可选）
# 获取方式：企业微信群 → 右键群名 → 添加群机器人 → 复制 Webhook 地址
WECOM_WEBHOOK_URL=
