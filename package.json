{
  "name": "cue-project-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "check": "node scripts/check-syntax.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:quick": "npm run check && npm run test:unit",
    "test:heavy": "node scripts/run-heavy-tests.mjs",
    "test:ci": "npm run test:quick && npm run test:heavy",
    "smoke": "node scripts/smoke-api.mjs",
    "test:regression": "node scripts/regression-tests.mjs",
    "test:v2": "node scripts/v2-regression-tests.mjs",
    "test:invariants": "node scripts/test-invariants.mjs",
    "test:event-replay": "node scripts/test-event-replay.mjs",
    "test:all": "npm run test:regression && npm run test:v2 && npm run test:invariants && npm run test:event-replay",
    "seed:memory": "node scripts/seed-project-memory.mjs",
    "seed:memory:dry": "node scripts/seed-project-memory.mjs --dry-run",
    "eval:llm": "promptfoo eval -c eval/llm-regression/config.clarify.yaml -c eval/llm-regression/config.gap.yaml",
    "eval:llm:plan": "promptfoo eval -c eval/llm-regression/config.plan.yaml",
    "eval:llm:view": "promptfoo view"
  },
  "engines": {
    "node": ">=18 <25"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fastify/cors": "^9.0.1",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "acorn": "^8.16.0",
    "acorn-typescript": "^1.4.13",
    "better-sqlite3": "^12.10.0",
    "eta": "^4.6.0",
    "fastify": "^4.29.1",
    "graphology": "^0.26.0",
    "graphology-pagerank": "^1.1.0",
    "kysely": "^0.29.2",
    "libsodium-wrappers": "^0.8.4",
    "mdast-util-to-string": "^4.0.0",
    "node-cron": "^4.2.1",
    "openai": "^6.39.0",
    "p-queue": "^9.3.0",
    "parse-diff": "^0.12.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sqlite-vec": "^0.1.9",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "c8": "^11.0.0"
  }
}
